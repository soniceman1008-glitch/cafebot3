ANTHROPIC_API_KEY=
PORT=
STAFF_API_KEY=

# Never set this to true/1 in production — enables Flask's interactive debugger, which
# exposes source code and stack traces to the client on any unhandled error. Leave unset
# (defaults to false) unless you're debugging locally.
FLASK_DEBUG=

# Comma-separated list of frontend origins allowed to make cross-origin requests to this
# backend. Defaults to the local dev frontend ports if unset.
ALLOWED_ORIGINS=

# Optional: requests per minute per client IP before an endpoint starts returning 429.
# Defaults shown; uncomment and adjust if needed.
# RATE_LIMIT_ORDER_PER_MINUTE=30
# RATE_LIMIT_CHAT_PER_MINUTE=30
# RATE_LIMIT_STAFF_PER_MINUTE=30
